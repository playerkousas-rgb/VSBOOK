# =========================================================================
# VSBOOK — Vercel 伺服器端環境變數範本（切勿加上 VITE_ 前綴）
# =========================================================================

# 1. 領袖模式密碼（必填以啟用「領袖只讀模式」，伺服器端比對，絕不送入前端 bundle）
# Vercel → Project → Settings → Environment Variables：
#   Name  = LEADER_CODE
#   Value = 你設定的領袖密碼（例如 6 位或以上字元）
#   Scope = Production（及 Preview）
# 設定後請按 Redeploy；若未設定則自動隱藏領袖模式入口（純成員版）。
# 本機 `npm run dev` 若未設定 LEADER_CODE，預設使用 1234 方便測試。
LEADER_CODE=

# 2. 兄弟後端 vsbadge 網址（選填，預設自動連接 https://vsbadge.vercel.app）
# 供領袖模式「一次看全團所有成員進度」及「一簽簽發所有成員（只錄入進度，不錄入個人資料）」使用。
# 若你有自建的 vsbadge Vercel 部署網址，可在此覆寫；留空即使用 https://vsbadge.vercel.app。
VSBADGE_ORIGIN=https://vsbadge.vercel.app
